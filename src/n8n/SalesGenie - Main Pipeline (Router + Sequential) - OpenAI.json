    {
      "parameters": {
        "jsCode": "\n// Hard gate: every recommended sku_or_name MUST string-match a row we actually retrieved\n// from the live catalog sheet. This is what makes the \"never invent a product\" rule\n// enforceable rather than just a prompt instruction (Technical Design Doc §3, Layer 3).\nconst item = $input.first().json;\nconst allowed = new Set((item.catalog_sku_list || []).map(s => String(s).toLowerCase().trim()));\nconst recs = item.recommendations || [];\nconst invalid = recs.filter(r => !allowed.has(String(r.sku_or_name).toLowerCase().trim()));\nconst validation_passed = invalid.length === 0;\nreturn [{ json: { ...item, validation_passed, invalid_recommendations: invalid } }];\n"
      },
