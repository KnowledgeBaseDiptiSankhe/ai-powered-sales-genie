    {
      "parameters": {
        "jsCode": "\n// Lightweight retrieval: keyword match on category/product_interest + budget filter.\n// In production this is a vector-similarity lookup (see Technical Design Doc §4);\n// this deterministic version keeps the reference build runnable without a vector DB.\nconst rows = $input.all().map(i => i.json);\nconst lead = $('Parse Qualifier Output').first().json;\nconst budget = lead.per_unit_budget || lead.budget_total || null;\nconst interest = (lead.product_interest || lead.category_hint || '').toLowerCase();\n\nconst scored = rows.map(r => {\n  const hay = `${r.name} ${r.category} ${r.description}`.toLowerCase();\n  let score = 0;\n  interest.split(/\\W+/).forEach(w => { if (w.length > 2 && hay.includes(w)) score += 2; });\n  const price = parseFloat(r.price);\n  const withinBudget = budget ? price <= Number(budget) : true;\n  return { ...r, _score: score, _within_budget: withinBudget };\n}).filter(r => r._within_budget)\n  .sort((a,b) => b._score - a._score)\n  .slice(0, 5);\n\nreturn [{ json: { ...lead, catalog_context: JSON.stringify(scored), catalog_sku_list: scored.map(s => s.name) } }];\n"
      },
