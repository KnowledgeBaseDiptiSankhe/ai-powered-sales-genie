    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(i => i.json);\nconst q = ($('Normalize Email Input').first().json.email_body || '').toLowerCase();\nconst scored = rows.map(r => {\n  const hay = `${r.name} ${r.category} ${r.description}`.toLowerCase();\n  let score = 0;\n  q.split(/\\W+/).forEach(w => { if (w.length > 2 && hay.includes(w)) score++; });\n  return { ...r, _score: score };\n}).sort((a,b) => b._score - a._score).slice(0, 5);\nconst base = $('Normalize Email Input').first().json;\nreturn [{ json: { ...base, catalog_context: JSON.stringify(scored) } }];\n"
      },
      "id": "8a148eab-6cce-484b-a951-2b63d34619e1",
      "name": "Retrieve Catalog Context (FAQ)",
      "type": "n8n-nodes-base.code",
